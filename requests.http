### Register user
# @name Register user
# @assert response.statusCode == 201
POST {{base.url}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "text@example.com",
  "password": "correct-horse-battery"
}

### Invalid Registration
# @name Invalid Registration
# @assert response.statusCode == 400
POST {{base.url}}/api/auth/register
Content-Type: application/json

{
  "username": "x",
  "email": "not-an-email-lol",
  "password": "short"
}

### Duplicate registration
# @name Duplicates registration
POST {{base.url}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "text@example.com",
  "password": "correct-horse-battery"
}

### Login user (Valid Creds)
# @name Login user (Valid creds)
# @assert response.statusCode == 200
POST {{base.url}}/api/auth/login
Content-Type: application/json

{
  "email": "text@example.com",
  "password": "correct-horse-battery"
}

### Login user (Invalid Creds)
# @name Login user (Invalid Creds)
# @assert response.statusCode == 401
POST {{base.url}}/api/auth/login
Content-Type: application/json

{
  "email": "text@example.com",
  "password": "wrong-pass"
}

### Login user (Unknown email)
# @name Login user (Unknown email)
# @assert response.statusCode == 401
POST {{base.url}}/api/auth/login
Content-Type: application/json

{
  "email": "does-not-exist@example.com",
  "password": "correct-horse-battery"
}

### Login user (Invalid payload)
# @name Login user (Invalid payload)
# @assert response.statusCode == 400
POST {{base.url}}/api/auth/login
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short"
}

### Refresh token - valid
# @name Refresh token (valid)
# @assert response.statusCode == 200
POST {{base.url}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "-dF51L3crqDBoHPyrWi75SbOl_IlM9c5u6dE8LecFow"
}

### Logout - valid refresh token
# @name Logout (valid token)
# @assert response.statusCode == 204
POST {{base.url}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "-dF51L3crqDBoHPyrWi75SbOl_IlM9c5u6dE8LecFow"
}

### Authenticated user
# @name Authenticated user
# @assert response.statusCode == 200
GET {{base.url}}/api/auth/me
Authorization: Bearer {{auth.token}}

### Missing token
# @name Missing token
# @assert response.statusCode == 401
GET {{base.url}}/api/auth/me

### Malformed token
# @name Malformed token
# @assert response.statusCode == 401
GET {{base.url}}/api/auth/me
Authorization: Bearer definitely-not-a-jwt

### MEMBER → member endpoint
# @name Change to member
# @assert response.statusCode == 200
GET {{base.url}}/api/auth/member-test
Authorization: Bearer {{auth.token}}

### MEMBER → moderator endpoint
# @name Change to moderator
# @assert response.statusCode == 403
GET {{base.url}}/api/auth/moderator-test
Authorization: Bearer {{auth.token}}

### MEMBER → admin endpoint
# @name Change to admin
# @assert response.statusCode == 403
GET {{base.url}}/api/auth/admin-test
Authorization: Bearer {{auth.token}}

### List channels
# @name List channels
# @assert response.statusCode == 200
GET {{base.url}}/api/channels
Authorization: Bearer {{auth.token}}

### MEMBER cannot create channel
# @name Member create channel
# @assert response.statusCode == 403
POST {{base.url}}/api/channels
Authorization: Bearer {{auth.token}}
Content-Type: application/json

{
  "name": "general",
  "description": "General community discussion"
}

### Create channel
# @name Create channel
# @assert response.statusCode == 201
POST {{base.url}}/api/channels
Authorization: Bearer {{auth.token}}
Content-Type: application/json

{
  "name": "general",
  "description": "General community discussion"
}

### Duplicate channel
# @name Duplicate channel
# @assert response.statusCode == 409
POST {{base.url}}/api/channels
Authorization: Bearer {{auth.token}}
Content-Type: application/json

{
  "name": "general",
  "description": "Duplicate"
}

### Get channel
# @name Get channel
# @assert response.statusCode == 200
GET {{base.url}}/api/channels/{{channel.id}}
Authorization: Bearer {{auth.token}}

### Join channel
# @name Join channel
# @assert response.statusCode == 204
POST {{base.url}}/api/channels/{{channel.id}}/join
Authorization: Bearer {{auth.token}}

### List members
# @name List members
# @assert response.statusCode == 200
GET {{base.url}}/api/channels/{{channel.id}}/members
Authorization: Bearer {{auth.token}}

### Leave channel
# @name Leave channel
# @assert response.statusCode == 204
DELETE {{base.url}}/api/channels/{{channel.id}}/leave
Authorization: Bearer {{auth.token}}